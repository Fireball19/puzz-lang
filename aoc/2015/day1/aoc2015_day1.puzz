# Advent of Code 2015 - Day 1: Not Quite Lisp
# Run: ./gradlew run --args="aoc/2015/day1/aoc2015_day1.puzz"

let input = read("aoc/2015/day1/aoc2015_day1_input.txt")

# ═══════════════════════════════════════════════════════════════════════════════
#  Part 1: What floor does Santa end up on?
# ═══════════════════════════════════════════════════════════════════════════════

print "Part 1: " + (input.count("(") - input.count(")"))

# ═══════════════════════════════════════════════════════════════════════════════
#  Part 2: Position of first character that causes Santa to enter basement (-1)
# ═══════════════════════════════════════════════════════════════════════════════

let floor = 0
let pos = 0
let answer = 0

for ch in input.chars():
    let pos = pos + 1
    if ch == "(":
        let floor = floor + 1
    if ch == ")":
        let floor = floor - 1
    if floor < 0:
        if answer == 0:
            let answer = pos
            
print "Part 2: " + answer